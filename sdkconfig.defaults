# 目标芯片
CONFIG_IDF_TARGET="esp32s3"

# 模组：ESP32-S3-WROOM-1 N8R8（Flash 8 MB + Octal PSRAM 8 MB）。
# 写过 0x1000000（8 MB 边界）会在下一段传输时串口断流，所以不用 16 MB。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# PSRAM：8 MB Octal。IDF 里这一档就叫 ESPPSRAM64（64 Mbit），没有更大的选项。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y

# 开机画面放在 artifacts 分区，不进应用镜像。Wi-Fi/OTA 加进来后应用约 1.79 MB，
# 默认 1 MB 分区装不下
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# OTA：新镜像首次启动标记为 PENDING_VERIFY，应用确认后转 VALID，未确认则回滚。
# 不开 CONFIG_BOOTLOADER_FACTORY_RESET：板上 GPIO3 是 KEY1，按键会被误判为恢复工厂。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
