# 目标芯片
CONFIG_IDF_TARGET="esp32s3"

# 实机为 16 MB Flash + 8 MB Octal PSRAM；0x1000000 是 16 MB 上界，不得越界访问。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# PSRAM：8 MB Octal。IDF 里这一档就叫 ESPPSRAM64（64 Mbit），没有更大的选项。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y

# 开机画面独立存放在 artifacts。当前应用约 1.02 MB，三个 1.5 MB 应用槽统一限制镜像大小。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# OTA：新镜像首次启动标记为 PENDING_VERIFY，应用确认后转 VALID，未确认则回滚。
# 不开 CONFIG_BOOTLOADER_FACTORY_RESET：板上 GPIO3 是 KEY1，按键会被误判为恢复工厂。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
