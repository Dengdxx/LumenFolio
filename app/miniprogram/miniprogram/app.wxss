page {
  min-height: 100%;
  background: #f7f6f0;
  color: #141413;
  font-size: 30rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  padding: 32rpx;
  border-radius: 16rpx;
  background: #fafaf7;
  border: 1rpx solid rgba(31, 30, 29, 0.12);
}

.heading {
  font-size: 34rpx;
  font-weight: 600;
}

.muted {
  color: #3d3c3a;
  font-size: 26rpx;
  line-height: 1.5;
}

.field {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f0efe8;
  border: 1rpx solid rgba(31, 30, 29, 0.18);
}

button {
  margin: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}

button::after {
  border: none;
}

.primary {
  color: #141413;
  background: #d07044;
}

.quiet {
  color: #141413;
  background: transparent;
  border: 1rpx solid rgba(31, 30, 29, 0.22);
}

.chip {
  width: auto;
  padding: 0 28rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #141413;
  background: transparent;
  border: 1rpx solid rgba(31, 30, 29, 0.22);
}

.chip.selected {
  color: #8c401d;
  background: #f4e2d9;
  border-color: transparent;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.error {
  color: #b83131;
  font-size: 26rpx;
}

@media (prefers-color-scheme: dark) {
  page {
    background: #0a0a0a;
    color: #f5f5f7;
  }

  .card {
    background: #1c1c1e;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .muted,
  .quiet,
  .chip {
    color: #98989d;
    border-color: rgba(255, 255, 255, 0.18);
  }

  .field {
    background: #2c2c2e;
    color: #f5f5f7;
    border-color: rgba(255, 255, 255, 0.18);
  }

  .primary {
    color: #141413;
    background: #0a84ff;
  }

  .chip.selected {
    color: #8cc8ff;
    background: #12324d;
  }

  .error {
    color: #ff6961;
  }
}
