page {
  min-height: 100%;
  background: #F7F5EE;
  color: #161616;
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.stack-sm {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* ───────────── 顶部工具栏与层级标题 ───────────── */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 0 8rpx;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.pill-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: auto !important;
  min-height: 68rpx;
  padding: 0 26rpx !important;
  margin: 0 !important;
  border-radius: 999rpx;
  border: 4rpx solid #161616;
  background: #FFFDF8;
  color: #161616;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.pill-action.mint {
  background: #B4E8D2;
}

.pill-action.yellow {
  background: #FAE69B;
}

.pill-action.blue {
  background: #BCE0F7;
}

.icon-circle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx !important;
  height: 72rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50%;
  border: 4rpx solid #161616;
  background: #FFFDF8;
}

.hero-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 0 6rpx;
  animation: cardRise 0.24s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
  letter-spacing: -0.5rpx;
  color: #161616;
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.45;
  color: #383633;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 4rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #161616;
}

.section-meta {
  font-size: 24rpx;
  font-weight: 600;
  color: #383633;
}

/* ───────────── 线稿色块主题系统 ───────────── */
.tone-mint {
  background: #B4E8D2 !important;
  color: #161616 !important;
}

.tone-yellow {
  background: #FAE69B !important;
  color: #161616 !important;
}

.tone-blue {
  background: #BCE0F7 !important;
  color: #161616 !important;
}

.tone-coral {
  background: #F8BDBD !important;
  color: #161616 !important;
}

.tone-apricot {
  background: #FBC6A0 !important;
  color: #161616 !important;
}

.tone-paper {
  background: #FFFDF8 !important;
  color: #161616 !important;
}

/* ───────────── 双列 Bento 矩阵卡片（左图风格） ───────────── */
.bento-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.bento-tile {
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 256rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  border: 4rpx solid #161616;
  background: #FFFDF8;
  color: #161616;
  text-align: left;
  transition: transform 0.14s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.14s ease, background-color 0.18s ease;
  animation: cardRise 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.bento-grid .bento-tile:nth-child(2) {
  animation-delay: 0.04s;
}

.bento-grid .bento-tile:nth-child(3) {
  animation-delay: 0.08s;
}

.bento-grid .bento-tile:nth-child(4) {
  animation-delay: 0.12s;
}

.bento-tile.compact {
  min-height: 212rpx;
  padding: 24rpx;
}

.bento-tile.active-tile {
  box-shadow: 0 8rpx 0 #161616;
  transform: translateY(-4rpx);
}

.bento-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.bento-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  border: 3rpx solid #161616;
  background: rgba(255, 253, 248, 0.88);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.4;
  color: #161616;
}

.bento-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 24rpx;
}

.bento-time {
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
  color: #262523;
}

.bento-name {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.24;
  color: #161616;
  word-break: break-word;
}

.bento-sub {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #2E2D2A;
}

/* ───────────── 横向色块任务条（右图风格） ───────────── */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-bar {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100% !important;
  min-height: 124rpx;
  padding: 22rpx 28rpx !important;
  margin: 0 !important;
  border-radius: 26rpx;
  border: 4rpx solid #161616;
  background: #FFFDF8;
  color: #161616;
  text-align: left;
  line-height: 1.35;
  transition: transform 0.14s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.14s ease, background-color 0.18s ease;
  animation: cardRise 0.24s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.task-list .task-bar:nth-child(2) {
  animation-delay: 0.04s;
}

.task-list .task-bar:nth-child(3) {
  animation-delay: 0.08s;
}

.task-list .task-bar:nth-child(4) {
  animation-delay: 0.12s;
}

.task-list .task-bar:nth-child(5) {
  animation-delay: 0.16s;
}

.task-list .task-bar:nth-child(n+6) {
  animation-delay: 0.2s;
}

.task-bar.selected-bar {
  box-shadow: 0 7rpx 0 #161616;
  transform: translateY(-3rpx);
}

.check-circle {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid #161616;
  background: rgba(255, 253, 248, 0.72);
}

.check-circle.solid {
  background: #FFFDF8;
}

.task-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.task-meta {
  font-size: 23rpx;
  font-weight: 700;
  color: #2B2A28;
}

.task-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #161616;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-pill {
  flex: none;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 3rpx solid #161616;
  background: rgba(255, 253, 248, 0.9);
  font-size: 22rpx;
  font-weight: 800;
  color: #161616;
}

/* ───────────── 通用线稿容器卡片与表单控件 ───────────── */
.card,
.panel-card {
  box-sizing: border-box;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #FFFDF8;
  border: 4rpx solid #161616;
  animation: cardRise 0.26s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
}

.heading {
  font-size: 34rpx;
  font-weight: 800;
  color: #161616;
}

.muted {
  color: #383633;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

.field {
  box-sizing: border-box;
  width: 100%;
  height: 112rpx;
  padding: 0 30rpx;
  border-radius: 22rpx;
  background: #F7F5EE;
  border: 4rpx solid #161616;
  font-size: 32rpx;
  font-weight: 600;
  color: #161616;
}

button {
  box-sizing: border-box;
  margin: 0;
  width: 100%;
  min-height: 0;
  padding: 0 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
  transition: transform 0.12s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.12s ease, opacity 0.12s ease, background-color 0.18s ease;
}

button:not([disabled]):active,
.tap-pressed {
  transform: translateY(3rpx) scale(0.985) !important;
  opacity: 0.92;
}

.bento-tile.active-tile.tap-pressed {
  box-shadow: 0 2rpx 0 #161616 !important;
  transform: translateY(2rpx) scale(0.985) !important;
}

button::after {
  border: none;
}

button[disabled] {
  opacity: 0.55;
}

.primary {
  color: #161616 !important;
  background: #B4E8D2 !important;
  border: 4rpx solid #161616 !important;
}

.danger-btn {
  color: #161616 !important;
  background: #F8BDBD !important;
  border: 4rpx solid #161616 !important;
}

.quiet {
  color: #161616 !important;
  background: #FFFDF8 !important;
  border: 4rpx solid #161616 !important;
}

.chip {
  width: auto !important;
  margin: 0 !important;
  padding: 0 30rpx !important;
  line-height: 70rpx;
  font-size: 27rpx;
  font-weight: 800;
  color: #161616 !important;
  background: #FFFDF8 !important;
  border: 4rpx solid #161616 !important;
  border-radius: 999rpx;
}

.chip.selected {
  color: #161616 !important;
  background: #B4E8D2 !important;
  box-shadow: 0 4rpx 0 #161616;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 3rpx solid #161616;
  background: #FAE69B;
  color: #161616;
  font-size: 23rpx;
  font-weight: 800;
}

.badge.online {
  background: #B4E8D2;
}

.error-banner,
.error {
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  border: 4rpx solid #161616;
  background: #F8BDBD;
  color: #161616;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
  animation: bannerPop 0.2s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.notice-banner {
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  border: 4rpx solid #161616;
  background: #FAE69B;
  color: #161616;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
  animation: bannerPop 0.2s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes cardRise {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeOnly {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes bannerPop {
  from {
    opacity: 0;
    transform: translateY(8rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ───────────── 矢量线稿图标系统（2px 墨线） ───────────── */
.line-icon {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
}

.line-icon.sm {
  width: 34rpx;
  height: 34rpx;
}

.line-icon.md {
  width: 44rpx;
  height: 44rpx;
}

