.field-placeholder {
  color: #6B675E;
}

@media (prefers-color-scheme: dark) {
  page {
    background: #0C1117;
    color: #F4EEE2;
  }

  .hero-title,
  .section-title,
  .heading,
  .bento-name,
  .task-title {
    color: #F4EEE2;
  }

  .hero-subtitle,
  .section-meta,
  .muted,
  .bento-time,
  .bento-sub,
  .task-meta {
    color: #C7C0B3;
  }

  .card,
  .panel-card,
  .bento-tile,
  .task-bar {
    background: #1B242E;
    border-color: #F4EEE2;
    color: #F4EEE2;
  }

  .tone-paper {
    background: #1B242E !important;
    color: #F4EEE2 !important;
  }

  .tone-mint {
    background: #2E6150 !important;
    color: #F4EEE2 !important;
  }

  .tone-yellow {
    background: #6B5A22 !important;
    color: #F4EEE2 !important;
  }

  .tone-blue {
    background: #2A5375 !important;
    color: #F4EEE2 !important;
  }

  .tone-coral {
    background: #6E3A3F !important;
    color: #F4EEE2 !important;
  }

  .tone-apricot {
    background: #6F4A32 !important;
    color: #F4EEE2 !important;
  }

  .bento-tile.active-tile {
    box-shadow: 0 8rpx 0 #F4EEE2;
  }

  .task-bar.selected-bar {
    box-shadow: 0 7rpx 0 #F4EEE2;
  }

  .bento-tag,
  .task-pill,
  .check-circle,
  .check-circle.solid {
    background: rgba(12, 17, 23, 0.72);
    border-color: #F4EEE2;
    color: #F4EEE2;
  }

  .pill-action,
  .icon-circle-btn,
  .quiet,
  .chip {
    background: #1B242E !important;
    border-color: #F4EEE2 !important;
    color: #F4EEE2 !important;
  }

  .pill-action.mint,
  .primary,
  .chip.selected,
  .badge.online {
    background: #2E6150 !important;
    border-color: #F4EEE2 !important;
    color: #F4EEE2 !important;
  }

  .chip.selected {
    box-shadow: 0 4rpx 0 #F4EEE2;
  }

  .pill-action.yellow,
  .badge,
  .notice-banner {
    background: #6B5A22 !important;
