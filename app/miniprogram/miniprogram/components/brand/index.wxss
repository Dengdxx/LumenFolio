.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.icon-frame {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFDF8;
  border: 4rpx solid #161616;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 0 #161616;
}

.icon {
  display: block;
}

.word {
  min-width: 0;
}

.bar .icon-frame {
  width: 72rpx;
  height: 72rpx;
}

.bar .icon {
  width: 54rpx;
  height: 54rpx;
}

.bar .word {
  width: 248rpx;
  height: 46rpx;
}

.hero {
  gap: 24rpx;
}

.hero .icon-frame {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
}

.hero .icon {
  width: 86rpx;
  height: 86rpx;
}

.hero .word {
  flex: 1;
  height: 76rpx;
}

.only-dark {
  display: none;
}

@media (prefers-color-scheme: dark) {
  .only-light {
    display: none;
  }

  .only-dark {
    display: block;
  }

  .icon-frame {
    background: #1B242E;
    border-color: #F4EEE2;
    box-shadow: 0 4rpx 0 #F4EEE2;
  }
}
