{
  "pages": [
    "pages/connect/index",
    "pages/compose/index",
    "pages/gallery/index",
    "pages/firmware/index"
  ],
  "window": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "LumenFolio",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "brand-mark": "/components/brand/index"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/connect/index",
        "text": "连接",
        "iconPath": "@tabIconConnect",
        "selectedIconPath": "@tabSelectedIconConnect"
      },
      {
        "pagePath": "pages/compose/index",
        "text": "取景",
        "iconPath": "@tabIconCompose",
        "selectedIconPath": "@tabSelectedIconCompose"
      },
      {
        "pagePath": "pages/gallery/index",
        "text": "图库",
        "iconPath": "@tabIconGallery",
        "selectedIconPath": "@tabSelectedIconGallery"
      },
      {
        "pagePath": "pages/firmware/index",
        "text": "固件",
        "iconPath": "@tabIconFirmware",
        "selectedIconPath": "@tabSelectedIconFirmware"
      }
    ]
  },
  "permission": {
    "scope.bluetooth": {
      "desc": "用于连接正在广播的 LumenFolio 相框"
    },
    "scope.userLocation": {
      "desc": "Android 发现蓝牙设备需要定位权限"
    }
  }
}
