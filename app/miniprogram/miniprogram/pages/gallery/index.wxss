.preview {
  box-sizing: border-box;
  width: 100%;
  height: 620rpx;
  background: #F7F5EE;
  border-radius: 24rpx;
  border: 4rpx solid #161616;
  animation: previewIn 0.36s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes previewIn {
  from {
    opacity: 0;
    transform: scale(0.97);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.action-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 56rpx 32rpx;
  text-align: center;
}

@media (prefers-color-scheme: dark) {
  .preview {
    background: #131921;
    border-color: #F4EEE2;
  }
}
