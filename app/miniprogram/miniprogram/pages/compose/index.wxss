.scroller {
  height: 100vh;
}

.bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: -8rpx 0 8rpx;
}

.link {
  width: auto;
  padding: 0 12rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #8c401d;
  background: transparent;
}

.viewport {
  position: relative;
  width: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
}

.viewport-canvas {
  width: 100%;
  height: 100%;
}

.veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  color: #3d3c3a;
  font-size: 24rpx;
  text-align: center;
}

.inks {
  display: flex;
  gap: 20rpx;
  overflow: auto;
}

.ink {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #3d3c3a;
  font-size: 22rpx;
  white-space: nowrap;
}

.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(31, 30, 29, 0.22);
}

.badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f4e2d9;
  color: #8c401d;
  font-size: 22rpx;
}

@media (prefers-color-scheme: dark) {
  .link {
    color: #8cc8ff;
  }

  .viewport {
    background: #2c2c2e;
  }

  .ink {
    color: #98989d;
  }

  .badge {
    background: #12324d;
    color: #8cc8ff;
  }
}
