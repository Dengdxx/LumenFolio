.selected-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #161616;
  word-break: break-all;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 56rpx 32rpx;
  text-align: center;
}

@media (prefers-color-scheme: dark) {
  .selected-name {
    color: #F4EEE2;
  }
}
